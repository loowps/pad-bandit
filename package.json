{
  "name": "pad-bandit-tauri",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": "24"
  },
  "scripts": {
    "dev": "pnpm --filter pad-bandit-ui run dev",
    "build": "pnpm --filter pad-bandit-ui run build",
    "build-only": "pnpm --filter pad-bandit-ui run build-only",
    "preview": "pnpm --filter pad-bandit-ui run preview",
    "type-check": "pnpm --filter pad-bandit-ui run type-check",
    "test:unit": "pnpm --filter pad-bandit-ui run test:unit",
    "test:unit:watch": "pnpm --filter pad-bandit-ui run test:unit:watch",
    "test:ci": "pnpm --filter pad-bandit-ui run test:ci",
    "test:coverage": "pnpm --filter pad-bandit-ui run test:coverage",
    "test:e2e": "pnpm --filter pad-bandit-ui run test:e2e",
    "test:e2e:ui": "pnpm --filter pad-bandit-ui run test:e2e:ui",
    "lint": "pnpm --filter pad-bandit-ui run lint",
    "format": "pnpm --filter pad-bandit-ui run format",
    "tauri": "tauri",
    "tauri:dev": "tauri dev -- --locked",
    "tauri:build": "tauri build -- --locked",
    "tauri:icon": "tauri icon"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4"
  }
}
