{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "pad-bandit-tauri",
  "version": "0.1.0",
  "identifier": "com.padbandit.app",
  "build": {
    "beforeDevCommand": "pnpm --filter pad-bandit-ui run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm --filter pad-bandit-ui run build",
    "frontendDist": "../src-ui/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Pad Bandit",
        "width": 1230,
        "height": 900,
        "center": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
