{
  "name": "pad-bandit-ui",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "build-only": "vite build",
    "preview": "vite preview",
    "type-check": "vue-tsc --build",
    "test:unit": "vitest --run",
    "test:unit:watch": "vitest",
    "test:ci": "vitest --run --coverage --reporter=default --reporter=junit --outputFile=test-results/junit.xml",
    "test:coverage": "vitest --run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "screenshots": "playwright test --config=playwright.screenshots.config.ts",
    "lint": "run-s \"lint:*\"",
    "lint:oxlint": "oxlint . --fix",
    "lint:eslint": "eslint . --fix --cache",
    "check": "run-s \"check:*\"",
    "check:oxlint": "oxlint .",
    "check:eslint": "eslint .",
    "check:format": "prettier --check --experimental-cli src",
    "format": "prettier --write --experimental-cli src"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-opener": "^2.7.2",
    "@vueuse/core": "^14.4.0",
    "pinia": "^4.1.0",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tsconfig/node24": "^24.0.5",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^24.19.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/coverage-v8": "^4.1.12",
    "@vitest/eslint-plugin": "^1.6.28",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-oxlint": "~1.73.0",
    "eslint-plugin-playwright": "^2.12.1",
    "eslint-plugin-vue": "~10.9.2",
    "jiti": "^2.7.0",
    "jsdom": "^29.1.1",
    "npm-run-all2": "^9.0.4",
    "oxlint": "~1.73.0",
    "prettier": "3.9.5",
    "typescript": "~6.0.3",
    "vite": "^8.3.5",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vitest": "^4.1.12",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.13"
  }
}
